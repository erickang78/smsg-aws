server {
 listen 80;
 server_name smsg.13-125-8-5.sslip.io;
 location /.well-known/acme-challenge/ { root /var/www/smsg-cert; }
 location / { return 301 https://$host$request_uri; }
}
server {
 listen 443 ssl;
 server_name smsg.13-125-8-5.sslip.io;
 ssl_certificate /etc/letsencrypt/live/smsg.13-125-8-5.sslip.io/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/smsg.13-125-8-5.sslip.io/privkey.pem;
 location / {
  proxy_pass http://127.0.0.1:8091;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Real-IP $remote_addr;
 }
}
