[Unit]
Description=SMSG operating code GitHub backup
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/smsg/backup-tools/github_code_backup.py
TimeoutStartSec=300
Nice=10
ExecStopPost=/usr/bin/python3 /opt/smsg/backup-tools/publish_status.py
